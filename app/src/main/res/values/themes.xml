<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always dark, deliberately not DayNight: a TV UI with no light variant. Every Material token
         the app or a framework dialog touches is mapped to the design tokens, so no default
         Material purple can surface anywhere (dialogs, switches, ripples, text selection). -->
    <style name="Theme.SteamController" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/text</item>
        <item name="colorPrimaryInverse">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/raised</item>
        <item name="colorOnSecondaryContainer">@color/text</item>
        <item name="colorTertiary">@color/success</item>
        <item name="colorOnTertiary">@color/on_accent</item>
        <item name="colorTertiaryContainer">@color/raised</item>
        <item name="colorOnTertiaryContainer">@color/text</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/on_accent</item>
        <item name="colorErrorContainer">@color/danger_container</item>
        <item name="colorOnErrorContainer">@color/danger</item>

        <item name="colorSurface">@color/bg</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/raised</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/bg</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/sheet</item>
        <item name="colorSurfaceContainerHighest">@color/surface_2</item>
        <item name="colorSurfaceBright">@color/raised</item>
        <item name="colorSurfaceDim">@color/bg</item>
        <item name="colorOutline">@color/line_strong</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorOnSurfaceInverse">@color/bg</item>
        <item name="colorSurfaceInverse">@color/text</item>
        <item name="colorControlHighlight">#1F1A9FFF</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorControlNormal">@color/text_secondary</item>

        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textColorHighlight">#551A9FFF</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>

        <item name="android:fontFamily">@font/barlow_regular</item>
        <item name="fontFamily">@font/barlow_regular</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.SteamController.Dialog</item>
    </style>

    <!-- Launch: the window background is the splash (bg + the G). MainActivity switches to
         Theme.SteamController in onCreate, and ui/tv/Splash.kt takes over from the same frame. -->
    <style name="Theme.Gamehub.Launch" parent="Theme.SteamController">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

    <!-- Confirmations and name prompts: sheet surface, 12dp corners, accent text buttons. -->
    <style name="ThemeOverlay.SteamController.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/sheet</item>
        <item name="colorSurfaceContainerHigh">@color/sheet</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/Shape.SteamController.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Dialog.Button.Quiet</item>
        <item name="buttonBarNeutralButtonStyle">@style/Dialog.Button.Quiet</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>
</resources>
