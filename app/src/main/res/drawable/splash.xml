<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window background (Android 11 has no SplashScreen API): OLED black and the G, centred.
     ui/tv/Splash.kt continues from exactly this frame (same mark, same size, same place). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:opacity="opaque">
    <item android:drawable="@color/bg" />
    <item
        android:width="112dp"
        android:height="112dp"
        android:gravity="center"
        android:drawable="@drawable/splash_mark" />
</layer-list>
